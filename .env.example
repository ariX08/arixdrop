# Signaling WebSocket URL (Cloudflare Worker)
# Local:  ws://localhost:8787
# Prod:   wss://arixdrop-signaling.<your-account>.workers.dev/ws
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8787

# Cloudflare Turnstile (invisible)
# Get keys from https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here
